<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyLists-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Push notifications from cedar-chat (Settings -> Notifications -> iPhone push). Xcode
	     builds get the sandbox APNs; App Store and TestFlight builds are switched to production
	     when signed. The server's "Environment" setting must match. -->
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>
