        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los modelos de IA que ofrece tu servidor aparecen en cuanto está disponible."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les modèles d’IA que propose votre serveur s’affichent dès qu’il est joignable."
          }
        }
      }
    },
    "The address must start with https:// or http://." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Adresse muss mit https:// oder http:// beginnen."
