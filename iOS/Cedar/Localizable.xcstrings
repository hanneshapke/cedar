          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette app"
          }
        }
      }
    },
    "This conversation no longer exists on the server." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Unterhaltung gibt es auf dem Server nicht mehr."
          }
        },
        "es" : {
          "stringUnit" : {
