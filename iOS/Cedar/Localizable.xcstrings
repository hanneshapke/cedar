    "Choose a time before events, new events, or both." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle eine Zeit vor Terminen, neue Termine oder beides."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige un tiempo antes de los eventos, los eventos nuevos o ambos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez un délai avant les événements, les nouveaux événements, ou les deux."
          }
        }
      }
    },
    "Choose at least one tool." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle mindestens ein Werkzeug."
          }
        },
