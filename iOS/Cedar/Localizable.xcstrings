    "Always for %@" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Immer für %@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siempre para %@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toujours pour %@"
          }
        }
      }
    },
    "An agent is a prompt Cedar runs on its own: on a schedule, when something changes, when a webhook is called, or when mail or a calendar event comes up." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Agent ist ein Prompt, den Cedar von selbst ausführt: nach Zeitplan, wenn sich etwas ändert, wenn ein Webhook aufgerufen wird oder wenn eine E-Mail oder ein Kalendertermin ansteht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un agente es un prompt que Cedar ejecuta por sí solo: según un horario, cuando algo cambia, cuando se llama a un webhook o cuando llega un correo o se acerca un evento del calendario."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un agent est un prompt que Cedar exécute tout seul : à heure fixe, quand quelque chose change, quand un webhook est appelé, ou quand un e-mail arrive ou qu’un événement du calendrier approche."
          }
        }
      }
    },
    "An agent that events start gets a careful selection unless you choose otherwise: no personal tools, and none that write to your Google account." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Agent, den Ereignisse starten, bekommt eine vorsichtige Auswahl, wenn du nichts anderes wählst: keine persönlichen Werkzeuge und keine, die in dein Google-Konto schreiben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un agente que se inicia por eventos recibe una selección prudente si no eliges otra cosa: ninguna herramienta personal y ninguna que escriba en tu cuenta de Google."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un agent lancé par des événements reçoit une sélection prudente, sauf choix contraire : aucun outil personnel, et aucun qui écrive dans votre compte Google."
          }
        }
      }
    },
    "An agent that events start reads text other people wrote (mail, a web page, what a webhook sends) and runs with nobody there to approve what its tools do." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Agent, den Ereignisse starten, liest Text, den andere geschrieben haben (E-Mails, eine Webseite, was ein Webhook schickt), und läuft, ohne dass jemand freigibt, was seine Werkzeuge tun."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un agente que se inicia por eventos lee texto escrito por otras personas (correos, una página web, lo que envía un webhook) y se ejecuta sin que nadie apruebe lo que hacen sus herramientas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un agent lancé par des événements lit du texte écrit par d’autres (des e-mails, une page web, ce qu’envoie un webhook) et s’exécute sans personne pour valider ce que font ses outils."
          }
        }
      }
    },
    "An agent's run can't be contributed." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Lauf eines Agenten kann nicht beigesteuert werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La ejecución de un agente no se puede contribuir."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’exécution d’un agent ne peut pas être contribuée."
          }
        }
      }
    },
