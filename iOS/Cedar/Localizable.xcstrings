    "Never" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nunca"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jamais"
          }
        }
      }
    },
    "Never: attached files and their names, your memory list, run and key identifiers, exact times, your region. Emails, phone and account numbers, IP addresses, keys and home-directory names become made-up stand-ins of the same shape, consistent within the conversation and random otherwise." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie: angehängte Dateien und ihre Namen, dein Gedächtnis, Lauf- und Schlüsselkennungen, genaue Zeiten, deine Region. E-Mail-Adressen, Telefon- und Kontonummern, IP-Adressen, Schlüssel und Namen von Benutzerverzeichnissen werden zu erfundenen Stellvertretern derselben Form, innerhalb der Unterhaltung einheitlich, sonst zufällig."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nunca: los archivos adjuntos y sus nombres, tu memoria, los identificadores de ejecución y de clave, las horas exactas, tu región. Correos, números de teléfono y de cuenta, direcciones IP, claves y nombres de carpetas personales pasan a ser sustitutos inventados con la misma forma, coherentes dentro de la conversación y aleatorios fuera de ella."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jamais : les fichiers joints et leurs noms, votre mémoire, les identifiants d'exécution et de clé, les heures exactes, votre région. Les e-mails, numéros de téléphone et de compte, adresses IP, clés et noms de dossiers personnels deviennent des substituts inventés de même forme, cohérents dans la conversation et aléatoires sinon."
          }
        }
      }
    },
