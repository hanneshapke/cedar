        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La ejecución de una respuesta ya no está en el servidor cedar; la conversación no se puede reconstruir."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'exécution d'une réponse n'est plus sur le serveur cedar ; la conversation ne peut pas être reconstituée."
          }
        }
      }
    },
