    "How Cedar tells you that a run has something for you. The methods are set up under Settings → Notifications in the web UI." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie Cedar dir sagt, dass ein Lauf etwas für dich hat. Die Methoden richtest du in der Web-Oberfläche unter Einstellungen → Benachrichtigungen ein."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cómo te avisa Cedar de que una ejecución tiene algo para ti. Los métodos se configuran en Configuración → Notificaciones en la interfaz web."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comment Cedar vous prévient qu’une exécution a quelque chose pour vous. Les méthodes se configurent sous Réglages → Notifications dans l’interface web."
          }
        }
      }
    },
    "How Long Before" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie lange vorher"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con cuánta antelación"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Combien de temps avant"
          }
        }
      }
    },
    "How often events may start a run, so a busy source can't start one after another. Without limits of its own: at most once every %@, and %lld runs in 24 hours." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie oft Ereignisse einen Lauf starten dürfen, damit eine rege Quelle nicht einen nach dem anderen startet. Ohne eigene Limits: höchstens einmal alle %1$@ und %2$lld Läufe in 24 Stunden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con qué frecuencia los eventos pueden iniciar una ejecución, para que una fuente muy activa no inicie una tras otra. Sin límites propios: como máximo una vez cada %1$@ y %2$lld ejecuciones en 24 horas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "À quelle fréquence des événements peuvent lancer une exécution, pour qu’une source très active n’en lance pas une après l’autre. Sans limites propres : au moins %1$@ entre deux exécutions, et %2$lld exécutions en 24 heures."
          }
        }
      }
    },
