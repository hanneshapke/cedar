        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un fichier choisi n'a pas pu être lu"
          }
        }
      }
    },
    "A record set is seen as its count, when it was last updated and its records, so the path “count” watches for new rows." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Satz wird als seine Anzahl, der Zeitpunkt der letzten Änderung und seine Zeilen gesehen; der Pfad „count“ achtet also auf neue Zeilen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un conjunto de datos se ve como su recuento, cuándo se actualizó por última vez y sus filas, así que la ruta «count» vigila si hay filas nuevas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un jeu de données est vu comme son nombre de lignes, sa dernière mise à jour et ses lignes ; le chemin « count » surveille donc les nouvelles lignes."
          }
        }
      }
    },
    "A response's run is no longer on the cedar server, so the conversation can't be rebuilt." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
