            "value" : "L’entrée de l’outil doit être un objet JSON, par exemple {\"city\": \"Zurich\"}."
          }
        }
      }
    },
    "The tools couldn't be loaded, so a careful selection can't be made. Try again." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
