    "No conversations noted yet. Once a conversation ends, what it was about is kept here, so Cedar can pick it up when you refer to it." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noch keine Unterhaltungen notiert. Wenn eine Unterhaltung endet, bleibt hier, worum es ging, damit Cedar daran anknüpfen kann, wenn du dich darauf beziehst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aún no hay conversaciones anotadas. Cuando una conversación termina, aquí queda de qué trató, para que Cedar la retome cuando la menciones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucune conversation notée pour l'instant. À la fin d'une conversation, son sujet est gardé ici pour que Cedar puisse s'y référer quand vous en parlez."
          }
        }
      }
    },
