          }
        }
      }
    },
    "This agent keeps the tools it has now. Choose the careful selection unless you are sure about them." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Agent behält die Werkzeuge, die er jetzt hat. Wähle die vorsichtige Auswahl, wenn du dir bei ihnen nicht sicher bist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este agente conserva las herramientas que tiene ahora. Elige la selección prudente si no estás seguro de ellas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cet agent conserve les outils qu’il a maintenant. Choisissez la sélection prudente si vous n’êtes pas sûr d’eux."
          }
        }
      }
    },
    "This app" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
