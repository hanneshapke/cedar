        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entrega conversaciones sueltas a un corpus compartido para entrenar modelos de agentes de pesos abiertos. Voluntario, una conversación cada vez, después de leer exactamente lo que sale."
