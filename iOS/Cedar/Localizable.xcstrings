    },
    "This server doesn't keep records between conversations yet. Update cedar to use records." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Server bewahrt noch keine Daten zwischen Unterhaltungen auf. Aktualisiere cedar, um Datensätze zu nutzen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este servidor todavía no guarda datos entre conversaciones. Actualiza cedar para usar los conjuntos de datos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce serveur ne conserve encore aucune donnée d'une conversation à l'autre. Mettez cedar à jour pour utiliser les jeux de données."
          }
        }
      }
    },
    "This server doesn't remember anything between conversations yet. Update cedar to use memory." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Server merkt sich noch nichts zwischen Unterhaltungen. Aktualisiere cedar, um das Gedächtnis zu nutzen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este servidor todavía no recuerda nada entre conversaciones. Actualiza cedar para usar la memoria."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce serveur ne retient encore rien d'une conversation à l'autre. Mettez cedar à jour pour utiliser la mémoire."
          }
        }
      }
    },
    "This server has no corpus to send to, so nothing can be sent from here." : {
      "localizations" : {
        "de" : {
