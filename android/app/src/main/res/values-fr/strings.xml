    <string name="contribute_settings_footnote">Donnez des conversations, une par une, à un corpus partagé pour entraîner des modèles d\'agents à poids ouverts. Sur choix explicite, après avoir lu exactement ce qui part.</string>
    <string name="contribute_this_conversation">Contribuer cette conversation</string>
