<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS only, like the iOS app under App Transport Security: cedar-chat is reached through
     tailscale serve or a reverse proxy with a certificate the phone trusts. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
