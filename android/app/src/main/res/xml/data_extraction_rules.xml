<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing is backed up or moved to a new phone: the access token is encrypted with a key that
     stays in this phone's Keystore, so a copy elsewhere couldn't be read anyway. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
