{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cedar",
  "identifier": "io.github.hanneshapke.cedar",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": []
  },
  "bundle": {
    "active": true,
    "targets": ["dmg"],
    "category": "DeveloperTool",
    "copyright": "Apache-2.0",
    "shortDescription": "Runs LLM agents in sandboxed containers, with a chat UI",
    "longDescription": "Cedar runs the cedar agent server and its web chat on this Mac. Each agent's tools run in a Docker container; the model server runs wherever you point it.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/cedar", "binaries/cedar-chat"],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "hardenedRuntime": true
    }
  }
}
