# Copy to .env in this folder and fill in. .env is git-ignored.
# A Dropbox or Google Drive share link to the export.zip the Health app made
# (Health → your picture → Export All Health Data). Anyone with the link must be able to view it.
# Instead, you can put export.zip (or export.xml) in this folder.
APPLE_HEALTH_EXPORT_URL=
# Optional: km or mi
# DISTANCE_UNIT=km
