# Copy to .env in this folder and fill in. .env is git-ignored.
# The address of your Dataiku instance. A self-hosted instance outside *.dataiku.io / *.dataiku.com
# also needs its host added to "network" in tool.json (in your own TOOLS_DIR copy).
# Not localhost: each call runs in a container of its own, where localhost is that container. For a
# DSS on your own machine, use its LAN address or http://host.docker.internal:<port> (Docker Desktop).
DKU_DSS_URL=https://your-instance.app.dataiku.io
# A personal API key of your Dataiku account (Profile → API keys)
DKU_API_KEY=
# Optional: true to only inspect (no builds, scenario runs or Cobuild changes)
# DKU_READ_ONLY=true
