# Copy to .env in this folder and fill in. .env is git-ignored.
TANDEM_EMAIL=
TANDEM_PASSWORD=
# us or eu: the region of your Tandem Source account
TANDEM_REGION=us
# The pump's timezone (IANA name); pump timestamps are local wall time
TANDEM_TIMEZONE=America/New_York
# Optional: the pump to use when the account has several (default: the most recently active)
# TANDEM_PUMP_SERIAL=
# Optional: mgdl or mmol
# GLUCOSE_UNIT=mgdl
# Optional: target range in mg/dL
# TARGET_LOW=70
# TARGET_HIGH=180
