# cedar reads these from the process environment (it does not load .env files itself).
# Try it with:  set -a; source .env; set +a; cargo run

# --- required ---------------------------------------------------------------
# Bearer tokens accepted by the API, comma-separated. Generate one with: openssl rand -hex 24
CEDAR_API_KEYS=change-me

# --- models and integrations managed from the chat UI -----------------------
# Keys (from CEDAR_API_KEYS) that may register models (/v1/admin/models), save a Brave Search,
# Best Buy or SerpApi key and connect a Google account (/v1/admin/integrations). For cedar-chat's Settings -> Model server
# & API keys, list cedar-chat's CEDAR_API_KEY.
# CEDAR_ADMIN_KEYS=
# Encrypts the credentials saved that way (model servers' API keys included), in cedar's database.
# 64 hex characters: openssl rand -hex 32. Without it, a model whose server needs no key can still
# be registered; the Brave, Best Buy and SerpApi keys and the Google account can only be set here, which
# always wins.
# CEDAR_SECRET_KEY=

# --- server -----------------------------------------------------------------
# BIND_ADDR=127.0.0.1:8080
# DATABASE_URL=sqlite://cedar.db
# RUST_LOG=info,sqlx=warn
# Shut down when stdin reaches end-of-file. For a launcher that holds a pipe to cedar (the macOS
# app): when it quits or crashes, cedar stops too instead of staying behind on the port.
# cedar-chat understands the same setting.
# CEDAR_EXIT_ON_STDIN_EOF=0

# --- model ------------------------------------------------------------------
# cedar talks to any OpenAI-compatible chat-completions server, one per registered model. Models
# are registered by an admin (PUT /v1/admin/models/{id}, or the chat UI's Settings), each with its
# server address, API key, model name and reasoning levels; there is no setting for them here, and
# runs are refused until one is registered. See "Models" in README.md.
# SYSTEM_PROMPT=
# The language and region of runs that don't name one (de, fr-CH, ...); the model still replies
# in the language each request is written in.
# DEFAULT_LOCALE=en
# MAX_TURNS_CAP=25

# --- limits -----------------------------------------------------------------
# MAX_CONCURRENT_RUNS=4        # runs executing at once; the rest stay queued
# MAX_ACTIVE_RUNS_PER_KEY=2    # queued + running runs per API key
# RUN_TIMEOUT_SECS=600
# TOOL_TIMEOUT_SECS=60
# TOOL_OUTPUT_MAX_BYTES=32768  # per stream (stdout / stderr), and per file read
# WORKSPACE_TTL_SECS=86400     # how long a finished run's workspace is kept for continuations
# PDF_PREVIEW_PAGES=10         # pages of attached PDFs (in all) a model that takes images sees as images

# --- webhooks ---------------------------------------------------------------
# A run started with a callback_url is POSTed a notification when it ends (see "Being told when
# a run ends" in README.md). The calls come from this host, so by default the URL may only point
# at a public address; set on to allow loopback and private addresses (a client on this machine).
# WEBHOOK_ALLOW_PRIVATE=off
# The wait before a failed call is retried; each later retry doubles it, up to an hour, 12 tries.
# WEBHOOK_RETRY_SECS=5

# --- web search -------------------------------------------------------------
# Setting a Brave Search API key turns on the web_search tool (an admin can also add one from the
# chat UI, see CEDAR_SECRET_KEY above). Get one at
# https://api-dashboard.search.brave.com/ . The key stays in the cedar process; it is never passed
# into a sandbox container.
# BRAVE_API_KEY=
# BRAVE_API_BASE_URL=https://api.search.brave.com/res/v1/web/search

# --- web fetching -----------------------------------------------------------
# fetch_url (read a page as text) and download_file (save a file into the workspace) run in the
# cedar process, so their requests come from this host. They are on by default and may only reach
# public addresses; set WEB_FETCH=off to remove them.
# WEB_FETCH=on
# Let them reach loopback, private, and link-local addresses too (this host, your LAN, cloud
# metadata endpoints). Only for testing or a trusted intranet.
# WEB_FETCH_ALLOW_PRIVATE=off

# --- weather ----------------------------------------------------------------
# weather_forecast looks up forecasts on Open-Meteo (https://open-meteo.com), which needs no API
# key. It runs in the cedar process and is on by default; set WEATHER=off to remove it. Open-Meteo's
# public API is free for non-commercial use only: for commercial use, point both URLs below at your
# own Open-Meteo instance or their commercial endpoint.
# WEATHER=on
# WEATHER_BASE_URL=https://api.open-meteo.com/v1/forecast
# WEATHER_GEOCODING_BASE_URL=https://geocoding-api.open-meteo.com/v1/search
# show_map (pins on a map in the chat UI) finds places with the same geocoding URL. It is on by
# default; set MAPS=off to remove it. The chat page loads the map tiles itself, from
# tile.openstreetmap.org (see chat/README.md).
# MAPS=on
# show_recipe (a recipe card in the chat UI) always looks up a photo of the dish: the lead image of the
# best matching Wikipedia article, else a Wikimedia Commons file. No API key. It is on by default;
# set RECIPES=off to remove it. The chat page loads the photo itself, from upload.wikimedia.org.
# RECIPES=on
# RECIPE_WIKIPEDIA_URL=https://en.wikipedia.org/w/api.php
# RECIPE_COMMONS_URL=https://commons.wikimedia.org/w/api.php
# plan_trip compares public transit, walking, driving, and a rideshare for a trip and recommends
# one; the chat UI shows it as a route map. Transit routes and place lookups come from a MOTIS trip
# planner (by default Transitous, a free community service), driving routes from an OSRM router
# (by default the OSRM project's demo server, meant for light use). Rideshare fares are estimated.
# On by default; set TRANSIT=off to remove it.
# TRANSIT=on
# TRANSIT_BASE_URL=https://api.transitous.org
# DRIVING_BASE_URL=https://router.project-osrm.org
# search_flights searches flights on Google Flights through SerpApi (one-way and round trips, with
# passengers, cabin, stops, airlines and a price cap) and shows them as a card with Google's price
# verdict and a Google Flights link. It is offered when a SerpApi key is set here or saved in
# Settings -> Server; get one at https://serpapi.com (the free plan covers a limited number of
# searches a month). Set FLIGHTS=off to remove it even with a key.
# SERPAPI_API_KEY=
# FLIGHTS=on
# FLIGHTS_API_URL=https://serpapi.com
# compare_stocks tracks and compares stocks, ETFs, and indices: quotes, a price chart against a
# benchmark index, returns, recent headlines, and a buy/hold/sell rating with its reasoning, shown
# as a card in the chat UI. Prices and news come from Yahoo Finance's public chart and search APIs
# (no key; unofficial, so they can change or rate-limit). On by default; set STOCKS=off to remove it.
# STOCKS=on
# STOCKS_CHART_URL=https://query1.finance.yahoo.com/v8/finance/chart
# STOCKS_NEWS_URL=https://query1.finance.yahoo.com/v1/finance/search
# search_products finds products to buy in any category: it searches the web with the Brave key
# (reviews and shops), reads the pages for their product data (photos, price, stock, ratings), and
# has the run's model pick the best options with its reasons; the chat UI shows them as a card. It
# is offered when a Brave key is set (above, or saved in Settings -> Server). A free Best Buy key
# from https://developer.bestbuy.com/ adds Best Buy's catalog to the search, and offers the tool on
# its own. The keys stay in the cedar process; the chat page loads product photos from the shops.
# Set PRODUCTS=off to remove the tool even with a key.
# BESTBUY_API_KEY=
# PRODUCTS=on
# PRODUCTS_API_URL=https://api.bestbuy.com/v1/products
# ask_user lets the model ask clarifying questions when a request is ambiguous: the run ends with
# the questions (stop_reason "ask_user"), the chat UI shows them as a form with choices (radio
# buttons or checkboxes) and a free-form answer, and the answer starts the next run. No network.
# On by default; set ASK_USER=off to remove it.
# ASK_USER=on
# Memory: runs see a short list of facts about the user from earlier conversations, and interactive
# runs can add to it with remember and change it with forget. It stays in cedar's database; the
# chat's Settings -> Memory lists and deletes it. No network. On by default; set MEMORY=off to remove
# the tools and the list. MEMORY_MAX_ITEMS caps the items per API key (500 characters each).
# MEMORY=on
# MEMORY_MAX_ITEMS=200

# --- Gmail and Calendar ----------------------------------------------------
# Offer Gmail and Calendar tools acting for one Google account. Needs an OAuth client and a refresh
# token for the account (see "Gmail and Calendar" in README.md). The tokens stay in the cedar
# process. With CEDAR_SECRET_KEY set, leave GOOGLE_REFRESH_TOKEN empty and use "Connect Google" in
# the chat's Settings instead (register <CHAT_PUBLIC_URL>/api/oauth/google/callback as a redirect
# URI of the OAuth client).
# GMAIL=off
# CALENDAR=off
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REFRESH_TOKEN=
# api (the default) calls the Gmail and Calendar REST APIs, which serve any account. mcp uses
# Google's Gmail and Calendar MCP servers, which only serve Cloud projects enrolled in the
# Workspace Developer Preview (Workspace accounts only).
# GOOGLE_BACKEND=api
# Which tools to offer, comma-separated, or * for all. The defaults read mail and write drafts,
# and read the calendar; nothing that sends, deletes, or changes events.
# GMAIL_TOOLS=search_threads,get_thread,list_labels,list_drafts,get_draft,create_draft
# CALENDAR_TOOLS=list_calendars,list_events,get_event,search_events,suggest_time
# GMAIL_API_URL=https://gmail.googleapis.com/gmail/v1/users/me
# CALENDAR_API_URL=https://www.googleapis.com/calendar/v3
# GMAIL_MCP_URL=https://gmailmcp.googleapis.com/mcp/v1
# CALENDAR_MCP_URL=https://calendarmcp.googleapis.com/mcp/v1
# GOOGLE_TOKEN_URL=https://oauth2.googleapis.com/token
# What "Connect Google" asks for, space-separated. The default covers the default tools.
# GOOGLE_SCOPES=openid email https://www.googleapis.com/auth/gmail.readonly https://www.googleapis.com/auth/gmail.compose https://www.googleapis.com/auth/calendar.readonly
# GOOGLE_AUTH_URL=https://accounts.google.com/o/oauth2/v2/auth

# --- sandbox ----------------------------------------------------------------
# The docker CLI: a name looked up on PATH, or an absolute path for a launcher that runs cedar
# without the user's PATH (the macOS app sets this).
# DOCKER_BIN=docker
# SANDBOX_IMAGE=cedar-sandbox:latest
# Docker network mode for the agent's container. "none" (the default) keeps it offline, which
# also means `pip install` can't reach PyPI; set "bridge" to let the agent install packages.
# SANDBOX_NETWORK=none
# What a conversation's sandbox may reach: "offline" (nothing), "packages" (pip and npm downloads),
# or the path of a JSON policy file (sandbox/policies/ has the two presets). Unset, it follows
# SANDBOX_NETWORK: "none" is offline, a network is packages. A Docker sandbox can't be limited to
# some hosts, so anything but offline gives it all of SANDBOX_NETWORK; an OpenShell sandbox reaches
# exactly what the policy allows.
# SANDBOX_POLICY=offline
# For OpenShell sandboxes, which an admin turns on in the chat (Settings → Advanced settings); see
# "OpenShell sandboxes (opt-in)" in README.md. The openshell CLI, and the OpenShell workspace
# cedar's sandboxes live in (one cedar per workspace: at startup cedar removes the sandboxes it
# finds there).
# OPENSHELL_BIN=openshell
# OPENSHELL_WORKSPACE=default
# SANDBOX_MEMORY=512m
# SANDBOX_CPUS=1
# A directory of personal tools written in Python, one folder per tool with a tool.json and a
# tool.py. Each call runs in a container of its own that sees only that tool's folder. See
# "Personal tools in Python" in README.md; examples/tools has two to start from.
# TOOLS_DIR=
# The Docker network for calls of personal tools whose tool.json declares `network` hosts (and
# for installing their `pip` packages). Tools that declare none always run without a network.
# With OpenShell sandboxes, a tool reaches exactly the hosts it declares instead.
# TOOLS_NETWORK=bridge
# The index of a community tool registry that admins can install tools from into TOOLS_DIR (see
# "Community tools" in README.md and registry/ in this repository). Unset: no marketplace.
# TOOLS_REGISTRY_URL=

# --- browser ----------------------------------------------------------------
# The browser tool drives a headless Chromium in a container of its own per run, started on the
# run's first browser call. Build the image first: docker build -t cedar-browser browser/
# BROWSER=off
# BROWSER_IMAGE=cedar-browser:latest
# The browser needs internet access. Only the URLs the model navigates to are checked, so links,
# redirects, and scripts can reach anything this network reaches; prefer one that only reaches the
# internet.
# BROWSER_NETWORK=bridge
# BROWSER_MEMORY=1g
# BROWSER_CPUS=1
