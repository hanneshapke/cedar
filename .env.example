# cedar reads these from the process environment (it does not load .env files itself).
# Try it with:  set -a; source .env; set +a; cargo run

# --- required ---------------------------------------------------------------
# Bearer tokens accepted by the API, comma-separated. Generate one with: openssl rand -hex 24
CEDAR_API_KEYS=change-me

# --- server -----------------------------------------------------------------
# BIND_ADDR=127.0.0.1:8080
# DATABASE_URL=sqlite://cedar.db
# RUST_LOG=info,sqlx=warn

# --- model ------------------------------------------------------------------
# cedar talks to any OpenAI-compatible chat-completions server; the default is a local vLLM
# serving DeepSeek V4 (see README.md for the `vllm serve` command).
# LLM_BASE_URL=http://localhost:8000/v1
# Only needed if the server was started with --api-key.
# LLM_API_KEY=
# Must match the model name the server registered (see: curl $LLM_BASE_URL/models).
# LLM_MODEL=deepseek-ai/DeepSeek-V4-Flash
# Comma-separated; if set, requests may only use these models (the default model is always allowed).
# ALLOWED_MODELS=
# SYSTEM_PROMPT=
# MAX_TOKENS=4096
# MAX_TURNS_CAP=25

# --- limits -----------------------------------------------------------------
# MAX_CONCURRENT_RUNS=4        # runs executing at once; the rest stay queued
# MAX_ACTIVE_RUNS_PER_KEY=2    # queued + running runs per API key
# RUN_TIMEOUT_SECS=600
# TOOL_TIMEOUT_SECS=60
# TOOL_OUTPUT_MAX_BYTES=32768  # per stream (stdout / stderr), and per file read
# WORKSPACE_TTL_SECS=86400     # how long a finished run's workspace is kept for continuations

# --- sandbox ----------------------------------------------------------------
# SANDBOX_IMAGE=cedar-sandbox:latest
# SANDBOX_NETWORK=none         # docker network mode; "none" disables networking
# SANDBOX_MEMORY=512m
# SANDBOX_CPUS=1
