# cedar reads these from the process environment (it does not load .env files itself).
# Try it with:  set -a; source .env; set +a; cargo run

# --- required ---------------------------------------------------------------
# Bearer tokens accepted by the API, comma-separated. Generate one with: openssl rand -hex 24
CEDAR_API_KEYS=change-me

# --- server -----------------------------------------------------------------
# BIND_ADDR=127.0.0.1:8080
# DATABASE_URL=sqlite://cedar.db
# RUST_LOG=info,sqlx=warn

# --- model ------------------------------------------------------------------
# cedar talks to any OpenAI-compatible chat-completions server; the default is a local vLLM
# serving DeepSeek V4 (see README.md for the `vllm serve` command).
# LLM_BASE_URL=http://localhost:8000/v1
# Only needed if the server was started with --api-key.
# LLM_API_KEY=
# Must match the model name the server registered (see: curl $LLM_BASE_URL/models).
# LLM_MODEL=deepseek-ai/DeepSeek-V4-Flash
# Comma-separated; if set, requests may only use these models (the default model is always allowed).
# ALLOWED_MODELS=
# SYSTEM_PROMPT=
# MAX_TOKENS=4096
# MAX_TURNS_CAP=25

# --- limits -----------------------------------------------------------------
# MAX_CONCURRENT_RUNS=4        # runs executing at once; the rest stay queued
# MAX_ACTIVE_RUNS_PER_KEY=2    # queued + running runs per API key
# RUN_TIMEOUT_SECS=600
# TOOL_TIMEOUT_SECS=60
# TOOL_OUTPUT_MAX_BYTES=32768  # per stream (stdout / stderr), and per file read
# WORKSPACE_TTL_SECS=86400     # how long a finished run's workspace is kept for continuations

# --- web search -------------------------------------------------------------
# Setting a Brave Search API key turns on the web_search tool. Get one at
# https://api-dashboard.search.brave.com/ . The key stays in the cedar process; it is never passed
# into a sandbox container.
# BRAVE_API_KEY=
# BRAVE_API_BASE_URL=https://api.search.brave.com/res/v1/web/search

# --- web fetching -----------------------------------------------------------
# fetch_url (read a page as text) and download_file (save a file into the workspace) run in the
# cedar process, so their requests come from this host. They are on by default and may only reach
# public addresses; set WEB_FETCH=off to remove them.
# WEB_FETCH=on
# Let them reach loopback, private, and link-local addresses too (this host, your LAN, cloud
# metadata endpoints). Only for testing or a trusted intranet.
# WEB_FETCH_ALLOW_PRIVATE=off

# --- sandbox ----------------------------------------------------------------
# SANDBOX_IMAGE=cedar-sandbox:latest
# Docker network mode for the agent's container. "none" (the default) keeps it offline, which
# also means `pip install` can't reach PyPI; set "bridge" to let the agent install packages.
# SANDBOX_NETWORK=none
# SANDBOX_MEMORY=512m
# SANDBOX_CPUS=1

# --- browser ----------------------------------------------------------------
# The browser tool drives a headless Chromium in a container of its own per run, started on the
# run's first browser call. Build the image first: docker build -t cedar-browser browser/
# BROWSER=off
# BROWSER_IMAGE=cedar-browser:latest
# The browser needs internet access. Only the URLs the model navigates to are checked, so links,
# redirects, and scripts can reach anything this network reaches; prefer one that only reaches the
# internet.
# BROWSER_NETWORK=bridge
# BROWSER_MEMORY=1g
# BROWSER_CPUS=1
